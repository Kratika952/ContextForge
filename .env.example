# Environment variables — copy to .env and fill in values.
# NEVER commit the real .env file.

# ── Application ──────────────────────────────────────────
# LOG_LEVEL=INFO
# APP_ENV=development

# ── Hugging Face (optional — only needed for gated models) ──
# HF_TOKEN=your_huggingface_token_here

# ── Database ─────────────────────────────────────────────
# SQLITE_DB_PATH=data/contextforge.db

# ── Paths ────────────────────────────────────────────────
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts
# CONFIG_DIR=config
